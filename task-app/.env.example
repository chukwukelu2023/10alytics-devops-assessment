# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored — never commit real credentials.
# In CI these same keys are injected from GitHub Secrets/Variables.

# --- Database (Sequelize) ---
DIALECT=mysql
DATABASE=taskmanager
DATABASE_USERNAME=taskuser
DB_PASSWORD=change-me
# Hostname of the database. Use "db" when running via docker compose
# (the MySQL service name); use "127.0.0.1" when running MySQL locally.
HOST=db
DB_PORT=3306

# --- Auth ---
# Secret used to sign JWTs. Generate one with:  openssl rand -hex 32
TOKEN_KEY=change-me

# --- App ---
PORT=4500
